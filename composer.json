{
	"keywords" : [
		"rage4"
	],
	"autoload" : {
		"psr-0" : {
			"Splitice" : "src"
		}
	},
	"name" : "splitice/rage4-api",
	"type" : "library",
	"license" : "MIT",
	"require" : {
		"php" : ">=5.4",
		"ext-curl" : "*",
		"ext-json" : "*"
	},
	"require-dev" : {
		"phpstan/phpstan" : "^2.1",
		"phpunit/phpunit" : "^9.6"
	},
	"scripts" : {
		"phpstan" : "phpstan analyse --no-progress",
		"test" : "phpunit"
	}
}
